    <!--
        Added the entity Task.
    -->
    <changeSet id="20190221093012-1" author="jhipster">
        <createTable tableName="TblTask">
            <column name="TaskID" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="TaskTitle" type="nvarchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="TaskDescription" type="nvarchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="DateStart" type="date">
                <constraints nullable="true" />
            </column>
            <column name="TimeStart" type="time(7)">
                <constraints nullable="true" />
            </column>
            <column name="DateEnd" type="date">
                <constraints nullable="true" />
            </column>
            <column name="TimeEnd" type="time(7)">
                <constraints nullable="true" />
            </column>
            <column name="TaskStatus" type="integer">
                <constraints nullable="true" />
            </column>
            <column name="TaskPriority" type="integer">
                <constraints nullable="true" />
            </column>
            <column name="DueDate" type="date">
                <constraints nullable="true" />
            </column>
            <column name="taskCategory" type="nvarchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="taskState" type="integer">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here, do not remove-->
        </createTable>
        <dropDefaultValue tableName="TblTask" columnName="TimeStart" columnDataType="time(7)"/>
        <dropDefaultValue tableName="TblTask" columnName="TimeEnd" columnDataType="time(7)"/>
    </changeSet>

